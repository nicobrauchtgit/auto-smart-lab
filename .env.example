# Copy to .env and provide the SAIA/GWDG Chat AI API key locally.
SAIA_API_KEY=
# Optional: enables the PI web_search extension for research stages.
TAVILY_API_KEY=

# SmartLab web login. Quote values containing shell-special characters.
LAB_USER=
LAB_PASS=

# University server access; keep real values only in the ignored .env file.
SMARTLAB_SSH_HOST=
SMARTLAB_SSH_USER=
SMARTLAB_SSH_PASSWORD=
