# Copy to .env (gitignored). Loaded by direnv via .envrc, or: set -a; source .env; set +a
LAB_USER=
LAB_PASS=
GWDG_API_KEY=
# Optional: enables the web_search tool
TAVILY_API_KEY=

# Optional: Google models via Gemini Enterprise Agent Platform (formerly Vertex AI), provider "google-vertex".
# Use EITHER an API key ...
GOOGLE_CLOUD_API_KEY=
# ... OR project + region + credentials (service-account JSON, or `gcloud auth application-default login`).
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
GOOGLE_APPLICATION_CREDENTIALS=

# Optional: Langfuse tracing of every pi session (@langfuse/pi-observability-plugin). Off when the keys are empty;
# LANGFUSE_TRACING_ENABLED=false disables it even with keys set.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
