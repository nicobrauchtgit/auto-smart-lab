# Copy to .env and provide the SAIA/GWDG Chat AI API key locally.
SAIA_API_KEY=
# Optional: enables the PI web_search extension for research stages.
TAVILY_API_KEY=

# Optional: enables Gemini through Google Cloud Agent Platform. Authenticate
# locally with `gcloud auth application-default login` or set
# GOOGLE_APPLICATION_CREDENTIALS to a service-account JSON file.
GOOGLE_CLOUD_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=

# SmartLab web login. Quote values containing shell-special characters.
LAB_USER=
LAB_PASS=

# University server access; keep real values only in the ignored .env file.
SMARTLAB_SSH_HOST=
SMARTLAB_SSH_USER=
SMARTLAB_SSH_PASSWORD=
