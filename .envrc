#!/usr/bin/env bash
# direnv entrypoint. Secrets live in the untracked .env (see .env.example).

# Optional devbox integration (skipped if devbox is not installed).
if command -v devbox >/dev/null 2>&1; then
  eval "$(devbox generate direnv --print-envrc)"
fi

# Load local secrets: LAB_USER, LAB_PASS, GWDG_API_KEY, optional TAVILY_API_KEY.
dotenv_if_exists .env
