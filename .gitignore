# macOS / FUSE-T sidecar files
._*
.DS_Store

# Secrets / sessions
.env
lab-cookies.txt
*.cookies

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local environments
.venv/
agent/runtime/python/.install.lock
env/

# Downloaded/generated SmartLab artifacts
data/
downloaded_task_page/
submissions/
reports/

# Downloaded course material stays local. Share archive hashes in unit-data.sha256.
/units/*
!/units/README.md
/challenges/

# Model implementations generated during pipeline runs stay local.
/solutions/*
!/solutions/README.md

# Transient agent sandbox (regenerated by agent/setup/load_challenge.py)
environment/*
!environment/.gitignore

# Temporary archives/output files
source.zip
output.csv
*.tmp

# Node
node_modules/
package-lock.json
**/.next/

# Agent memory (runtime state, not committed)
agent/memory/memory.json

# Session logs
logs/

# Project-local PI runtime state. The provider/model definition in
# .pi/agent/models.json is deliberately tracked; credentials stay in the shell.
.pi/agent/auth.json
.pi/agent/bin/
.pi/agent/models-store.json
.pi/agent/sessions/
.pi/agent/tmp/
.pi/agent/*.lock
.pi/agent/*.sqlite*

# Run artifacts stay local. Traces record full message content on every update,
# so a single 30-minute run writes hundreds of megabytes; the tree was 1.3 GB
# before this line existed.
/runs/

# Raw development experiment recordings stay local too.
/docs/research/sklearn-observability/obs-*.jsonl

# Scratch scripts the solve agent writes while working.
/train_*.py
/verify_*.py
/run_iteration*.py
