{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.17.5/.schema/devbox.schema.json",
  "packages": [
    "python-full@3.13.5",
    "bun@latest",
    "postgresql@17",
    "pi-coding-agent@0.84.1",
    "ripgrep@latest",
    "fd@latest",
    "unzip@latest",
    "uv@latest",
    "google-cloud-sdk@latest",
    "zip@latest",
    "stdenv.cc.cc.lib",
    "zlib@latest"
  ],
  "env_from": ".env",
  "env": {
    "AGENT_DATABASE_PORT": "55433",
    "PGDATABASE": "postgres",
    "PGPORT": "55433",
    "UV_PROJECT_ENVIRONMENT": "$DEVBOX_PROJECT_ROOT/.venv",
    "UV_PYTHON_DOWNLOADS": "never"
  },
  "shell": {
    "init_hook": [
      "export PI_CODING_AGENT_DIR=\"$DEVBOX_PROJECT_ROOT/.pi/agent\"",
      "export VIRTUAL_ENV=\"$VENV_DIR\"",
      "export PATH=\"$VENV_DIR/bin:$PATH\"",
      "export LD_LIBRARY_PATH=\"$(\"$VENV_DIR/bin/python\" -I \"$DEVBOX_PROJECT_ROOT/agent/setup/python_environment.py\" library-path)\"",
      "\"$VENV_DIR/bin/python\" -I \"$DEVBOX_PROJECT_ROOT/agent/setup/python_environment.py\" ensure || echo '[python-environment] Readiness check failed; run devbox run python-setup when no runs are using the environment.' >&2"
    ],
    "scripts": {
      "python-setup": [
        "\"$VENV_DIR/bin/python\" -I \"$DEVBOX_PROJECT_ROOT/agent/setup/python_environment.py\" setup"
      ],
      "pi": [
        "set -a; . \"$DEVBOX_PROJECT_ROOT/.env\"; set +a; PI_CODING_AGENT_DIR=\"$DEVBOX_PROJECT_ROOT/.pi/agent\" pi"
      ],
      "pi-sdk": [
        "bun agent/pi_sdk.ts"
      ],
      "test": [
        "bun test",
        "bun run test:py"
      ]
    }
  }
}
