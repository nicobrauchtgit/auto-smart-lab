{
  "version": 1,
  "setup": {
    "timeoutMs": 30000,
    "modelMaxTokens": 16
  },
  "pipeline": {
    "maxStageInvocations": 8
  },
  "session": {
    "maxWallMs": 28800000,
    "stallMs": 600000,
    "stallRetries": 2
  },
  "context": {
    "handoffTokens": 100000,
    "maxHandoffBytes": 65536
  },
  "research": {
    "profileTimeoutMs": 300000,
    "profileTextMinPercent": 90
  },
  "solve": {
    "maxIterations": 6,
    "seed": 13,
    "foldPolicy": "auto",
    "experimentUpdateIntervalSeconds": 30,
    "idleWakeMs": 600000
  },
  "holdout": {
    "targetSmallestClassRows": 200,
    "minSmallestClassRows": 50,
    "maxFraction": 0.2,
    "groupFraction": 0.1
  },
  "search": {
    "confirmAboveSeconds": 900,
    "overrunFactor": 1.5,
    "maxSeconds": 7200,
    "validationTimeoutSeconds": 60
  },
  "foldRecommendations": [
    {
      "belowRows": 500,
      "folds": 10,
      "repeats": 5
    },
    {
      "belowRows": 2000,
      "folds": 10,
      "repeats": 3
    },
    {
      "belowRows": 10000,
      "folds": 10,
      "repeats": 1
    },
    {
      "belowRows": null,
      "folds": 5,
      "repeats": 1
    }
  ],
  "supervisor": {
    "updateIntervalMs": 5000,
    "linesPerUpdate": 5,
    "minStallMs": 15000,
    "stallGapMultiple": 4,
    "importPreludeMs": 12000,
    "idleCpuPercent": 5,
    "sampleIntervalMs": 250,
    "maxConcurrent": 2,
    "stopGraceMs": 2000
  },
  "subagents": {
    "turnTimeoutMs": 1800000,
    "waitTimeoutMs": 30000,
    "maxWaitTimeoutMs": 60000,
    "limits": {
      "maxConcurrent": 4,
      "maxChildren": 32,
      "maxQueuedMessages": 8,
      "maxMessageBytes": 32768,
      "maxResultBytes": 8192
    }
  }
}
