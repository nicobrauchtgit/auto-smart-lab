{
  "name": "auto-smart-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "fetch-unit": "bun harness/finetuned/agent/setup/fetch_unit_cli.ts",
    "pipeline": "bun harness/finetuned/agent/pipeline_cli.ts",
    "research": "bun harness/finetuned/agent/research_cli.ts",
    "test:py": "\"${VENV_DIR:-$PWD/harness/finetuned/.venv}/bin/python\" -m unittest discover -s harness/finetuned/agent/setup/tests && \"${VENV_DIR:-$PWD/harness/finetuned/.venv}/bin/python\" -m unittest discover -s harness/finetuned/agent/training/python -p 'test_*.py' && \"${VENV_DIR:-$PWD/harness/finetuned/.venv}/bin/python\" -m unittest discover -s harness/finetuned/agent/evaluation -p 'test_*.py' && \"${VENV_DIR:-$PWD/harness/finetuned/.venv}/bin/python\" -m unittest discover -s harness/finetuned/agent/research/python -p 'test_*.py'",
    "pi:hi": "bun harness/finetuned/agent/pi_sdk.ts",
    "telemetry:smoke": "bun harness/finetuned/agent/telemetry/smoke.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "evaluate-stage": "bun harness/finetuned/agent/evaluate_cli.ts",
    "solve-stage": "bun harness/finetuned/agent/solve_cli.ts",
    "refit-stage": "bun harness/finetuned/agent/refit_cli.ts",
    "orchestrate": "bun harness/finetuned/agent/orchestrate_cli.ts",
    "experiment": "bun experiment/cli.ts",
    "scorecard": "bun harness/finetuned/agent/scorecard_cli.ts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.84.1",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@langfuse/client": "5.13.1",
    "@langfuse/otel": "5.13.1",
    "@langfuse/pi-observability-plugin": "0.1.2",
    "@langfuse/tracing": "5.13.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/otlp-transformer": "0.223.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@opentelemetry/sdk-trace-node": "2.12.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.13",
    "typescript": "7.0.2"
  }
}
