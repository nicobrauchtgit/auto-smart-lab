{
  "name": "auto-smart-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "fetch-unit": "bun harness/finetuned/agent/setup/fetch_unit_cli.ts",
    "pipeline": "bun harness/finetuned/agent/pipeline_cli.ts",
    "test:py": "\"${VENV_DIR:-$PWD/harness/finetuned/.venv}/bin/python\" -m unittest discover -s harness/finetuned/agent/setup/tests && \"${VENV_DIR:-$PWD/harness/finetuned/.venv}/bin/python\" -m unittest discover -s harness/finetuned/agent/training/python -p 'test_*.py' && \"${VENV_DIR:-$PWD/harness/finetuned/.venv}/bin/python\" -m unittest discover -s harness/finetuned/agent/research/python -p 'test_*.py'",
    "pi:hi": "bun harness/finetuned/agent/pi_sdk.ts",
    "telemetry:smoke": "bun harness/finetuned/agent/telemetry/smoke.ts",
    "test": "bun test",
    "test:fast": "bun test --path-ignore-patterns='runs/**' --path-ignore-patterns='harness/finetuned/agent/refit/service.test.ts' --path-ignore-patterns='harness/finetuned/agent/submission/submission.test.ts' --path-ignore-patterns='harness/finetuned/agent/training/search_harness.test.ts' --path-ignore-patterns='harness/finetuned/agent/experiments/supervisor.test.ts' --path-ignore-patterns='harness/finetuned/agent/training/recovery.test.ts' --path-ignore-patterns='harness/finetuned/agent/confirmation/service.test.ts' --path-ignore-patterns='harness/finetuned/agent/solve/task_data.test.ts' --path-ignore-patterns='harness/finetuned/agent/training/measurements.test.ts' --path-ignore-patterns='harness/finetuned/agent/training/smoke.test.ts' --path-ignore-patterns='harness/finetuned/agent/run/solve_sandbox.test.ts' --path-ignore-patterns='harness/finetuned/agent/training/versioned_harness.test.ts' --path-ignore-patterns='harness/finetuned/agent/training/validation.test.ts' --path-ignore-patterns='harness/finetuned/agent/training/development_selection.test.ts' --path-ignore-patterns='harness/finetuned/agent/training/evidence_selection.test.ts' --path-ignore-patterns='harness/finetuned/agent/refit/sample_task.test.ts' --path-ignore-patterns='harness/finetuned/agent/experiments/index.test.ts' --path-ignore-patterns='harness/finetuned/agent/training/trial_checks.test.ts' --path-ignore-patterns='harness/finetuned/agent/training/validation_measurements.test.ts' --path-ignore-patterns='harness/finetuned/agent/training/live_harness.test.ts'",
    "typecheck": "tsc --noEmit",
    "refit-stage": "bun harness/finetuned/agent/refit_cli.ts",
    "experiment": "bun experiment/cli.ts",
    "lead-stage": "bun harness/finetuned/agent/lead_cli.ts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.84.1",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@langfuse/client": "5.13.1",
    "@langfuse/otel": "5.13.1",
    "@langfuse/pi-observability-plugin": "0.1.2",
    "@langfuse/tracing": "5.13.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/otlp-transformer": "0.223.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@opentelemetry/sdk-trace-node": "2.12.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.13",
    "typescript": "7.0.2"
  }
}
