{
  "pipeline": {
    "version": 1,
    "entryStage": "research",
    "scheduling": "configured",
    "stages": {
      "research": {
        "enabled": true,
        "options": {}
      },
      "solve": {
        "enabled": true,
        "options": {}
      },
      "evaluate": {
        "enabled": true
      },
      "submit": {
        "enabled": false
      },
      "refit": {
        "enabled": true,
        "options": {}
      }
    },
    "tasks": {
      "spam1": {
        "schemaVersion": 1,
        "kind": "binary_classification",
        "samples": {
          "source": "zip_members",
          "train": "spam1-train.zip",
          "test": "spam1-test.zip"
        },
        "targets": {
          "kind": "binary",
          "file": "spam1-train.labels"
        },
        "execution": "inductive",
        "holdout": "stratified",
        "metric": "balanced_accuracy",
        "refit": "fit_training_predict_test",
        "submission": {
          "format": "id_semicolon_prediction",
          "predictions": "binary"
        }
      },
      "spam2": {
        "schemaVersion": 1,
        "kind": "binary_classification",
        "samples": {
          "source": "zip_members",
          "train": "spam2-train.zip",
          "test": "spam2-test.zip"
        },
        "targets": {
          "kind": "binary",
          "file": "spam2-train.labels"
        },
        "execution": "inductive",
        "holdout": "stratified",
        "metric": "balanced_accuracy",
        "refit": "fit_training_predict_test",
        "submission": {
          "format": "id_semicolon_prediction",
          "predictions": "binary"
        }
      },
      "spam3": {
        "schemaVersion": 1,
        "kind": "binary_classification",
        "samples": {
          "source": "zip_members",
          "train": "webspam-train.zip",
          "test": "webspam-test.zip"
        },
        "targets": {
          "kind": "binary",
          "file": "webspam-train.labels"
        },
        "execution": "inductive",
        "holdout": "stratified",
        "metric": "balanced_accuracy",
        "refit": "fit_training_predict_test",
        "submission": {
          "format": "id_semicolon_prediction",
          "predictions": "binary"
        }
      }
    }
  },
  "agent": {
    "cwd": ".",
    "agentDir": ".pi/agent",
    "initialPrompt": "hi"
  },
  "defaultModel": "mythllm/qwen3.8-flash-next-a5b",
  "providers": {
    "mythllm": {
      "name": "TU Berlin MythLLM",
      "baseUrl": "https://mythllm.mlsec.tu-berlin.de/v1",
      "api": "openai-completions",
      "apiKeyEnv": "MYTHLLM_API_KEY",
      "models": [
        {
          "id": "qwen3.8-flash-next-a5b",
          "name": "Qwen 3.8 Flash Next A5B",
          "reasoning": true,
          "input": ["text"],
          "contextWindow": 262144,
          "maxTokens": 32768
        }
      ]
    },
    "google-vertex": {
      "builtin": true
    },
    "saia": {
      "name": "SAIA / GWDG Chat AI",
      "baseUrl": "https://chat-ai.academiccloud.de/v1",
      "api": "openai-completions",
      "apiKeyEnv": "SAIA_API_KEY",
      "models": [
        {
          "id": "mistral-medium-3.5-128b",
          "name": "Mistral Medium 3.5 128B",
          "reasoning": false,
          "input": [
            "text",
            "image"
          ],
          "contextWindow": 256000,
          "maxTokens": 16384
        }
      ]
    }
  }
}
