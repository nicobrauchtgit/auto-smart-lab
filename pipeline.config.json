{
  "pipeline": {
    "version": 1,
    "entryStage": "research",
    "scheduling": "configured",
    "stages": {
      "research": {
        "enabled": true,
        "options": {}
      },
      "solve": {
        "enabled": true,
        "options": {}
      },
      "evaluate": {
        "enabled": true
      },
      "submit": {
        "enabled": true
      },
      "refit": {
        "enabled": true,
        "options": {}
      }
    }
  },
  "agent": {
    "cwd": ".",
    "agentDir": ".pi/agent",
    "initialPrompt": "hi"
  },
  "defaultModel": "saia/mistral-medium-3.5-128b",
  "providers": {
    "google-vertex": {
      "builtin": true
    },
    "saia": {
      "name": "SAIA / GWDG Chat AI",
      "baseUrl": "https://chat-ai.academiccloud.de/v1",
      "api": "openai-completions",
      "apiKeyEnv": "SAIA_API_KEY",
      "models": [
        {
          "id": "mistral-medium-3.5-128b",
          "name": "Mistral Medium 3.5 128B",
          "reasoning": false,
          "input": [
            "text",
            "image"
          ],
          "contextWindow": 256000,
          "maxTokens": 16384
        }
      ]
    }
  }
}
